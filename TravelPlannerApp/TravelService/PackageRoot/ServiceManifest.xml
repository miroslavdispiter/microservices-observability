<?xml version="1.0" encoding="utf-8"?>
<ServiceManifest Name="TravelServicePkg"
                 Version="1.0.0"
                 xmlns="http://schemas.microsoft.com/2011/01/fabric"
                 xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ServiceTypes>
    <!-- This is the name of your ServiceType. 
         This name must match the string used in the RegisterServiceAsync call in Program.cs. -->
    <StatelessServiceType ServiceTypeName="TravelServiceType" />
  </ServiceTypes>

  <!-- Code package is your service executable. -->
  <CodePackage Name="Code" Version="1.0.0">
    <EntryPoint>
      <ExeHost>
        <Program>TravelService.exe</Program>
      </ExeHost>
    </EntryPoint>

    <!-- Distributed Tracing: standardne OpenTelemetry promenljive okruzenja.
         OTLP exporter ih cita automatski, pa se endpoint Jaeger-a ne mora hardkodovati u kodu.
         4317 je OTLP/gRPC port koji Jaeger container publikuje na host masinu. -->
    <EnvironmentVariables>
      <EnvironmentVariable Name="OTEL_EXPORTER_OTLP_ENDPOINT" Value="http://localhost:4317" />
      <EnvironmentVariable Name="OTEL_EXPORTER_OTLP_PROTOCOL" Value="grpc" />
    </EnvironmentVariables>
  </CodePackage>

  <!-- Config package is the contents of the Config directory under PackageRoot that contains an
       independently-updateable and versioned set of custom configuration settings for your service. -->
  <ConfigPackage Name="Config" Version="1.0.0" />

  <Resources>
    <Endpoints>
      <!-- This endpoint is used by the communication listener to obtain the port on which to
           listen. Please note that if your service is partitioned, this port is shared with
           replicas of different partitions that are placed in your code. -->
      <Endpoint Name="ServiceEndpoint" />

      <!-- Endpoint resurs za V2 remoting listener. Instrumentirani remoting provider
           (TraceContextEnrichedServiceRemotingProvider) podrazumevano trazi resurs pod
           ovim imenom; port dodeljuje Service Fabric dinamicki iz opsega aplikacije. -->
      <Endpoint Name="ServiceEndpointV2" />

      <!-- Fiksni HTTP endpoint samo za /health, odvojen od Service Remoting endpointa -->
      <Endpoint Protocol="http" Name="HealthEndpoint" Type="Input" Port="7012" />
    </Endpoints>
  </Resources>
</ServiceManifest>